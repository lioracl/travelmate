<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/travelmate_widget_background"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layoutDirection="locale"
    android:contentDescription="@string/live_today_widget_description">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/live_widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/live_today_widget_title"
            android:textColor="#24322E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_widget_unread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/travelmate_widget_unread_background"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/live_widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#52645E"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/live_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#1F2926"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/live_widget_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/live_today_widget_activity"
        android:textColor="#34443F"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/live_widget_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#2F7D75"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/live_widget_open_plan"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:background="@drawable/travelmate_widget_action_background"
        android:text="@string/live_today_widget_open_day"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
